{
  "name": "uncava-website",
  "version": "0.0.0",
  "private": true,
  "description": "The public website, blog and documentation for Uncava at uncava.com.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run lint && npm run format:check && npm run check && npm run test && npm run build && npm run check:csp",
    "lhci": "lhci autorun",
    "check:csp": "node scripts/check-csp.ts"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.0",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "satori": "0.33.4",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
  }
}
