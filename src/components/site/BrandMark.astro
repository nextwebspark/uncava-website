---
/**
 * The Uncava mark, as the app draws it: an isometric cube with a filled top face, in currentColor.
 * `size` is the height; the width follows the 72 × 104 glyph. Below 28px the stroke thickens, as
 * the app's bold icons do, so the outline doesn't vanish into a hairline.
 */
interface Props {
  size?: number;
  label?: string;
  class?: string;
}

const { size = 30, label, class: className } = Astro.props;

const width = Math.round((size * 72) / 104);
const strokeWidth = size >= 28 ? 2.6 : size >= 20 ? 4 : 5.5;
---

<svg
  width={width}
  height={size}
  viewBox="-36 -51 72 104"
  fill="none"
  stroke="currentColor"
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path
    d="M-32 10 L 0 -8 L 32 10 L 0 28 Z M-32 10 V 32 L 0 50 L 32 32 V 10 M0 28 V 50"
    stroke-width={strokeWidth}
    stroke-linejoin="round"
  ></path>
  <path d="M0 -48 L 32 -30 L 0 -12 L -32 -30 Z" fill="currentColor" stroke="none"></path>
</svg>
