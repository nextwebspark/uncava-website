---
/**
 * The Uncava mark: a rhombus over a hexagon. `dark` is the dark tile for light grounds, `light`
 * inverts it for dark grounds, and `glyph` is the untiled mark in currentColor (watermarks).
 */
interface Props {
  size?: number;
  tone?: 'dark' | 'light' | 'glyph';
  label?: string;
  class?: string;
}

const { size = 30, tone = 'dark', label, class: className } = Astro.props;

const glyphColor = tone === 'glyph' ? 'currentColor' : tone === 'dark' ? '#f4f5f7' : '#16181c';
const tileColor = tone === 'dark' ? '#16181c' : '#f4f5f7';
---

<svg
  width={size}
  height={size}
  viewBox="86 86 340 340"
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {tone !== 'glyph' && <rect x="86" y="86" width="340" height="340" rx="74" fill={tileColor} />}
  <g fill={glyphColor} stroke={glyphColor} stroke-width="11" stroke-linejoin="round">
    <path d="M256 131 332 174 256 216 180 174Z"></path>
    <path d="M256 241 332 285V336L256 380 180 336V285Z" fill="none"></path>
  </g>
</svg>
