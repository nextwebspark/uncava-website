---
import { primaryNav, site } from '~/lib/site';
import BrandLockup from './BrandLockup.astro';
import ButtonLink from './ButtonLink.astro';
import Icon from './Icon.astro';

interface Props {
  tone: 'dark' | 'light';
  overlay?: boolean;
}

const { tone, overlay = false } = Astro.props;
const isDark = tone === 'dark';
const pathname = Astro.url.pathname.replace(/\.html$/, '');

function isCurrent(href: string): boolean {
  if (href.includes('#')) return false;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class:list={[
    isDark ? 'border-b border-d-text/6 text-d-text' : 'border-b border-line bg-panel text-text',
    overlay && 'absolute inset-x-0 top-0 z-20',
  ]}
>
  <nav aria-label="Primary" class="relative">
    <div class="container-page flex items-center justify-between py-2 pr-4 md:pr-10 lg:py-[21px] xl:pr-20">
      <BrandLockup tone={isDark ? 'light' : 'dark'} size="lg" class="lg:gap-[11px]" />

      <ul class="hidden items-center gap-[34px] lg:flex">
        {primaryNav.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'text-sm font-medium transition-colors',
                isDark
                  ? 'text-d-text-2 hover:text-d-text aria-[current=page]:text-d-text'
                  : 'text-text-2 hover:text-text aria-[current=page]:text-text',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href={site.appUrl}
          class:list={[
            'px-3.5 py-[9px] text-sm font-medium transition-colors',
            isDark ? 'text-d-text-2 hover:text-d-text' : 'text-text-2 hover:text-text',
          ]}
        >
          Sign in
        </a>
        <ButtonLink href="/contact" size="sm">
          Book a demo
        </ButtonLink>
      </div>

      <details class="group lg:hidden">
        <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-lg [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Menu</span>
          <Icon name="menu" size={22} class="group-open:hidden" />
          <Icon name="close" size={22} class="hidden group-open:block" />
        </summary>
        <div
          class:list={[
            'absolute inset-x-0 top-full z-30 flex flex-col border-b px-5 pt-2 pb-5 shadow-float',
            isDark ? 'border-ink-line bg-ink' : 'border-line bg-panel',
          ]}
        >
          <ul class="flex flex-col">
            {primaryNav.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center text-base font-medium',
                    isDark
                      ? 'text-d-text-2 aria-[current=page]:text-d-text'
                      : 'text-text-2 aria-[current=page]:text-text',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-3 flex flex-col gap-2.5">
            <ButtonLink href="/contact" block>
              Book a demo
            </ButtonLink>
            <ButtonLink
              href={site.appUrl}
              variant={isDark ? 'outline-dark' : 'outline-light'}
              block
            >
              Sign in
            </ButtonLink>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
