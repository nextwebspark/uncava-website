---
import { primaryNav, site } from '~/lib/site';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';

interface Props {
  tone: 'dark' | 'light';
  overlay?: boolean;
}

const { tone, overlay = false } = Astro.props;
const isDark = tone === 'dark';
const pathname = Astro.url.pathname.replace(/\.html$/, '');

function isCurrent(href: string): boolean {
  if (href.includes('#')) return false;
  return pathname === href || pathname.startsWith(`${href}/`);
}

const link = isDark
  ? 'text-d-text-2 hover:text-d-text aria-[current=page]:text-d-text'
  : 'text-text-2 hover:text-text aria-[current=page]:text-text';
const primary = isDark
  ? 'bg-d-text text-ink hover:bg-white'
  : 'bg-accent text-on-accent hover:bg-accent-hover';
---

<header
  class:list={[
    isDark ? 'text-d-text' : 'border-b border-line bg-panel text-text',
    overlay ? 'absolute inset-x-0 top-0 z-20' : isDark && 'border-b border-hairline',
  ]}
>
  <nav aria-label="Primary" class="relative">
    <div
      class:list={[
        isDark ? 'container-wide' : 'container-page',
        'flex items-center justify-between gap-4 py-4',
      ]}
    >
      <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} home`}>
        <BrandMark size={26} weight="fine" />
        <span class="wordmark text-[15px]">{site.name}</span>
      </a>

      <div class="hidden items-center gap-6.5 text-[14px] lg:flex">
        {primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={['transition-colors', link]}
          >
            {item.label}
          </a>
        ))}
        <span
          class:list={['h-4 w-px', isDark ? 'bg-[rgba(255,255,255,.14)]' : 'bg-line']}
          aria-hidden="true"
        ></span>
        <a href={site.appUrl} class:list={['transition-colors', link]}>
          Sign in
        </a>
        <a
          href="/contact"
          class:list={[
            'rounded-[6px] px-4 py-3 text-[14px] leading-none font-medium transition-colors',
            primary,
          ]}
        >
          Book a demo
        </a>
      </div>

      <details class="group lg:hidden">
        <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-lg [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Menu</span>
          <Icon name="menu" size={22} class="group-open:hidden" />
          <Icon name="close" size={22} class="hidden group-open:block" />
        </summary>
        <div
          class:list={[
            'absolute inset-x-0 top-full z-30 flex flex-col border-b px-5 pt-2 pb-5 shadow-float',
            isDark ? 'border-ink-line bg-ink' : 'border-line bg-panel',
          ]}
        >
          <ul class="flex flex-col">
            {primaryNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={['flex min-h-11 items-center text-base font-medium', link]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-3 flex flex-col gap-2.5">
            <a
              href="/contact"
              class:list={[
                'flex min-h-11 items-center justify-center rounded-[6px] px-4 text-[15px] font-medium',
                primary,
              ]}
            >
              Book a demo
            </a>
            <a
              href={site.appUrl}
              class:list={[
                'flex min-h-11 items-center justify-center rounded-[6px] border px-4 text-[15px] font-medium',
                isDark ? 'border-[rgba(255,255,255,.18)] text-d-text' : 'border-line text-text',
              ]}
            >
              Sign in
            </a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
