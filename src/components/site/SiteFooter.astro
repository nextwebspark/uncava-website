---
import { footerColumns, footerLegal, site } from '~/lib/site';
import BrandMark from './BrandMark.astro';

interface Props {
  tone?: 'dark' | 'adaptive';
}

const { tone = 'adaptive' } = Astro.props;
const isDark = tone === 'dark';
const year = new Date().getFullYear();

const heading = isDark ? 'text-d-text' : 'text-text';
const link = isDark
  ? 'text-d-text-2 transition-colors hover:text-d-text'
  : 'text-text-2 transition-colors hover:text-text';
const quiet = isDark
  ? 'text-d-text-3 transition-colors hover:text-d-text-2'
  : 'text-text-3 transition-colors hover:text-text-2';
const rule = isDark ? 'border-ink-line' : 'border-line';

function relFor(href: string): string | undefined {
  if (href === site.linkedIn) return 'me noopener';
  return undefined;
}
---

<footer class:list={['border-t text-[14px]', rule, isDark ? 'bg-ink' : 'bg-paper']}>
  <div
    class:list={[
      isDark ? 'container-wide' : 'container-page',
      'flex flex-col gap-14 pt-16 pb-12 md:pt-20',
    ]}
  >
    <nav
      aria-label="Footer"
      class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6"
    >
      <a
        href="/"
        class:list={[
          'col-span-2 flex items-center gap-2.5 self-start sm:col-span-3 lg:col-span-1',
          heading,
        ]}
        aria-label={`${site.name} home`}
      >
        <BrandMark size={26} weight="fine" />
        <span class="wordmark text-[15px]">{site.name}</span>
      </a>
      {footerColumns.map((column) => (
        <div class="flex flex-col gap-5">
          <h2 class:list={['text-[14px] leading-none font-medium', heading]}>{column.title}</h2>
          <ul class="flex flex-col gap-1 sm:gap-3">
            {column.links.map((item) => (
              <li>
                <a
                  href={item.href}
                  rel={relFor(item.href)}
                  class:list={['inline-flex min-h-11 items-center sm:min-h-0', link]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div
      class:list={[
        'flex flex-wrap items-center justify-between gap-x-7 gap-y-3 border-t pt-6 text-[13px]',
        rule,
      ]}
    >
      <ul class="flex flex-wrap gap-x-7 gap-y-1">
        {footerLegal.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['inline-flex min-h-11 items-center sm:min-h-0', quiet]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <span class={isDark ? 'text-d-text-3' : 'text-text-3'}>
        © {year} {site.name}. All rights reserved.
      </span>
    </div>
  </div>
</footer>
