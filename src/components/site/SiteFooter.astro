---
import { compactFooterNav, footerNav, site } from '~/lib/site';
import BrandLockup from './BrandLockup.astro';

interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'compact' } = Astro.props;
const year = new Date().getFullYear();
---

{variant === 'full' ? (
  <footer class="border-t border-line">
    <div class="container-page flex flex-col gap-6 py-9 md:gap-14 md:pt-16 md:pb-10">
      <div class="grid grid-cols-2 gap-x-4 gap-y-6 md:grid-cols-[2fr_repeat(3,minmax(0,1fr))] md:gap-12">
        <div class="col-span-2 flex flex-col gap-3.5 md:col-span-1">
          <BrandLockup size="md" class="self-start" />
          <p class="hidden max-w-[300px] text-sm leading-[1.6] text-text-3 md:block">
            The workspace for executive search and talent mapping.
          </p>
        </div>
        {footerNav.map((group) => (
          <nav aria-label={group.heading} class="flex flex-col md:gap-3">
            <p class="eyebrow hidden text-[11px] text-text-3 md:block">{group.heading}</p>
            <ul class="flex flex-col md:gap-3">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="flex min-h-11 items-center text-[15px] text-text-2 transition-colors hover:text-text md:min-h-0 md:text-sm"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <div class="flex flex-col gap-2 text-[13px] text-text-3 md:flex-row md:justify-between md:border-t md:border-line-soft md:pt-6">
        <span>
          © {year} {site.name}
        </span>
        <span>
          {site.legalName} · {site.registeredAddress}
        </span>
      </div>
    </div>
  </footer>
) : (
  <footer class="border-t border-line">
    <div class="container-page flex flex-col items-start gap-4 py-8 text-sm text-text-3 md:flex-row md:items-center md:justify-between">
      <BrandLockup size="sm" class="text-text" />
      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-4 sm:flex sm:flex-wrap sm:gap-x-7">
          {compactFooterNav.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-11 items-center text-text-3 transition-colors hover:text-text sm:min-h-0"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <span>
        © {year} {site.name}
      </span>
    </div>
  </footer>
)}
