---
import SectionHead from './SectionHead.astro';

const groundwork = [
  {
    title: 'Maps and tiers the market',
    detail:
      'Companies by sector and country, tiered against the brief, plus adjacent sectors you might miss.',
  },
  {
    title: 'Finds the executives in role',
    detail:
      'Pulls the people holding the role at each target company, filtered by level, title and location. Your team picks who goes in.',
  },
  {
    title: 'Benchmarks pay from disclosed packages',
    detail: 'Shows where your offer sits before the first call.',
  },
  {
    title: 'Transcribes interviews and tracks evidence',
    detail: 'Flags which competencies have been covered, with consent.',
  },
  {
    title: 'Drafts scores and a suggested ranking',
    detail: 'Every number traceable back to its source.',
  },
];

const judgement = [
  { title: 'Reads leadership potential', detail: 'What a CV and a transcript can’t show.' },
  {
    title: 'Judges culture fit',
    detail: 'How someone will land with this team and its leadership.',
  },
  { title: 'Aligns the hiring manager', detail: 'Resets the brief with evidence, early.' },
  { title: 'Builds candidate trust', detail: 'The conversations that turn a maybe into a yes.' },
  { title: 'Makes the final call', detail: 'AI suggests. Your team decides.' },
];
---

<section id="judgement" class="sq-sec jd-sq">
  <div class="wrap">
    <div class="sq-frame">
      <SectionHead
        title="AI does the groundwork."
        muted="You make the judgement calls."
        intro="Uncava handles the research, from mapping the market to finding who’s in role, so your team spends its time on the part that decides whether a hire works."
      />
      <div class="jd-grid">
        <div class="jd-col jd-ai">
          <div class="jd-cap">
            <i>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M10 2.5l1.6 4.4 4.4 1.6-4.4 1.6L10 14.5l-1.6-4.4L4 8.5l4.4-1.6L10 2.5z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                ></path>
                <path
                  d="M15.5 13.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z"
                  fill="currentColor"
                ></path>
              </svg>
            </i>
            <div>
              <h3 class="m-0 contents">
                <b>Uncava does the groundwork</b>
              </h3>
              <span>Research, admin and first drafts</span>
            </div>
          </div>
          <ul class="jd-list">
            {groundwork.map((item) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M3 8.5l3.2 3L13 4.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <div>
                  {item.title}
                  <small>{item.detail}</small>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="jd-mid" aria-hidden="true">
          <span>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path
                d="M4 9h10m-4-4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
        </div>
        <div class="jd-col jd-hu">
          <div class="jd-cap">
            <i>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="6.5" r="3.2" stroke="currentColor" stroke-width="1.5"></circle>
                <path
                  d="M3.8 17c.8-3.2 3.3-5 6.2-5s5.4 1.8 6.2 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                ></path>
              </svg>
            </i>
            <div>
              <h3 class="m-0 contents">
                <b>Your team makes the call</b>
              </h3>
              <span>Judgement, relationships and decisions</span>
            </div>
          </div>
          <ul class="jd-list">
            {judgement.map((item) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="5.2" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="8" cy="8" r="1.8" fill="currentColor" />
                </svg>
                <div>
                  {item.title}
                  <small>{item.detail}</small>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="jd-foot">
        <span>Every AI suggestion waits for a person to approve it.</span>
        <a class="font-medium text-d-accent-soft no-underline" href="#highlights">
          See how it works on every search →
        </a>
      </div>
    </div>
  </div>
</section>
