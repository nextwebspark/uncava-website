---
// Bar widths are classes, not inline styles: the site CSP allows no style attributes.
const pyramid = [
  { level: 'Board', women: 'w-[20%]', men: 'w-[55%]' },
  { level: 'C-Suite', women: 'w-[38%]', men: 'w-[80%]' },
  { level: 'N-1', women: 'w-[52%]', men: 'w-[72%]' },
  { level: 'N-2', women: 'w-[64%]', men: 'w-[60%]' },
];

const circumference = 100;
const nationalities = [
  { share: 44, stroke: 'stroke-seq-4' },
  { share: 22, stroke: 'stroke-green' },
  { share: 16, stroke: 'stroke-signal' },
  { share: 10, stroke: 'stroke-seq-3' },
];
const arcs = nationalities.map((slice, index) => {
  const before = nationalities.slice(0, index).reduce((sum, { share }) => sum + share, 0);
  return { ...slice, offset: circumference / 4 - before };
});
---

<div class="grid grid-cols-[1fr_96px] items-center gap-3.5">
  <div class="flex flex-col gap-[7px]">
    <div class="grid grid-cols-[1fr_44px_1fr] gap-1.5 font-mono text-[10.5px] font-medium tracking-[0.06em] text-text-2 uppercase">
      <span class="text-right">Women</span>
      <span></span>
      <span>Men</span>
    </div>
    {pyramid.map((row) => (
      <div class="grid grid-cols-[1fr_44px_1fr] items-center gap-1.5">
        <span class:list={['h-2.5 justify-self-end rounded-l-[5px] bg-seq-4', row.women]}></span>
        <span class="text-center text-[10.5px] font-medium text-text-2">{row.level}</span>
        <span class:list={['h-2.5 rounded-r-[5px] bg-seq-2', row.men]}></span>
      </div>
    ))}
  </div>
  <svg width="96" height="96" viewBox="0 0 42 42" focusable="false">
    <circle cx="21" cy="21" r="15.9" fill="none" stroke-width="6" class="stroke-seq-1"></circle>
    {arcs.map((arc) => (
      <circle
        cx="21"
        cy="21"
        r="15.9"
        fill="none"
        stroke-width="6"
        stroke-dasharray={`${arc.share} ${circumference - arc.share}`}
        stroke-dashoffset={arc.offset}
        class={arc.stroke}
      />
    ))}
    <text x="21" y="23.5" text-anchor="middle" class="fill-text font-mono text-[7px] font-semibold">
      11
    </text>
  </svg>
</div>
<p class="text-[11.5px] text-text-2">11 nationalities across the longlist</p>
