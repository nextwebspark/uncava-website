---
import Icon from '~/components/site/Icon.astro';
---

<div class="flex items-center gap-2 text-xs font-medium text-text-2">
  <Icon name="file" size={14} />
  PD_Group_CFO.pdf
  <span class="ml-auto font-mono text-[10.5px]">Read from document</span>
</div>
<div class="flex items-center justify-between">
  <span class="text-[12.5px] font-medium">Reports to</span>
  <span class="font-mono text-[10.5px] font-medium text-inferred-text">High confidence</span>
</div>
<div class="rounded-[7px] border border-l-2 border-line border-l-inferred bg-inferred-dim px-2.5 py-[7px] text-[13px]">
  Group Chief Executive
</div>
<p class="text-xs leading-normal text-text-2 italic">
  “…reporting directly to the Group Chief Executive…”
</p>
<div class="flex gap-1.5">
  <span class="rounded-md bg-text px-2.5 py-[5px] text-[11.5px] font-semibold text-white">
    Accept
  </span>
  <span class="rounded-md border border-line px-2.5 py-[5px] text-[11.5px] font-medium text-text-2">
    Dismiss
  </span>
</div>
