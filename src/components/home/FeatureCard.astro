---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<li class="flex flex-col gap-2 rounded-2xl border border-line bg-panel p-6 md:gap-[22px] md:rounded-[18px] md:p-8">
  <div
    class="hidden flex-col gap-2 rounded-xl border border-line bg-panel-2 p-3.5 md:flex has-[.visual-bleed]:border-0 has-[.visual-bleed]:p-0"
    aria-hidden="true"
  >
    <slot />
  </div>
  <div class="flex flex-col gap-2 md:gap-2.5">
    <h3 class="text-[19px] leading-[1.25] tracking-title md:text-[22px]">{title}</h3>
    <p class="text-[15px] leading-[1.55] text-text-2 md:text-[14.5px] md:leading-[1.6]">{body}</p>
  </div>
</li>
