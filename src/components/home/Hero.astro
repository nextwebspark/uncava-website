---
import ButtonLink from '~/components/site/ButtonLink.astro';
import Icon from '~/components/site/Icon.astro';
import HeroGlobe from './HeroGlobe.astro';
import AssistantHeroCard from './ai/AssistantHeroCard.astro';
import MandateCard from './MandateCard.astro';
---

<section
  class="relative overflow-hidden bg-ink pt-[61px] text-d-text lg:pt-[83px]"
  aria-labelledby="hero-title"
>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid hidden lg:block" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-[1440px] pb-10 lg:min-h-[700px] lg:grid-cols-[minmax(0,560px)_1fr] lg:pb-0 lg:pl-10 xl:grid-cols-[600px_1fr] xl:pl-20">
    <div class="flex flex-col gap-5 px-5 pt-9 md:px-10 lg:justify-center lg:gap-7 lg:px-0 lg:pt-10 lg:pb-24">
      <p class="flex items-center gap-2 self-start rounded-full border border-ink-line bg-ink-2/70 py-1.5 pr-3 pl-[9px] lg:gap-2.5 lg:py-[7px] lg:pr-3.5 lg:pl-2.5">
        <span class="size-1.5 rounded-full bg-d-accent lg:size-[7px] lg:shadow-[0_0_0_4px_rgb(110_121_242/0.18)]"></span>
        <span class="eyebrow text-d-text-2">C-suite executive search</span>
      </p>

      <h1
        id="hero-title"
        class="text-[44px] leading-[1.02] tracking-display md:text-6xl lg:text-[64px] lg:leading-none xl:text-[76px]"
      >
        Build the strategy behind{' '}
        <span class="text-d-accent">
          every <span class="whitespace-nowrap">C-suite</span> search.
        </span>
      </h1>

      <p class="max-w-[520px] text-[17px] leading-[1.55] text-pretty text-d-text-2 lg:text-[19px]">
        <span class="hidden md:inline">Uncava turns a brief into a search strategy</span>
        <span class="md:hidden">Turn a brief into a search strategy</span> — target sectors,
        adjacent industries, the company universe and the off-limits list — then{' '}
        <span class="hidden md:inline">
          maps the executives and brings the client into the shortlist.
        </span>
        <span class="md:hidden">map the executives and bring the client in.</span>
      </p>

      <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-3">
        <ButtonLink href="/contact" class="py-[15px] text-base sm:py-3.5 sm:text-[15px]">
          Book a demo
        </ButtonLink>
        <ButtonLink
          href="#workflow"
          variant="outline-dark"
          class="py-[15px] text-base sm:px-5 sm:py-3.5 sm:text-[15px]"
        >
          See how it works <Icon name="arrow-right" class="hidden sm:block" />
        </ButtonLink>
      </div>

      <p class="hidden items-center gap-2.5 text-[13px] text-d-text-3 md:flex">
        <Icon name="shield-check" />
        Every workspace isolated. Every client seat read-only.
      </p>
    </div>

    <div class="relative mt-3 h-[330px] sm:h-[440px] lg:mt-0 lg:h-[700px]">
      <HeroGlobe class="absolute inset-0 m-auto h-full w-full lg:inset-auto lg:top-[10px] lg:left-[30px] lg:h-[700px] lg:w-[700px]" />
      <AssistantHeroCard class="absolute top-[388px] left-0 hidden w-[300px] lg:flex" />
      <MandateCard class="absolute inset-x-5 -bottom-2 sm:inset-x-auto sm:left-1/2 sm:w-[360px] sm:-translate-x-1/2 lg:top-[92px] lg:right-10 lg:bottom-auto lg:left-auto lg:w-[236px] lg:translate-x-0 xl:right-20" />
    </div>
  </div>
</section>

<style>
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(380px 360px at 60% 70%, rgb(110 121 242 / 0.12), transparent 70%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(244 246 248 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(244 246 248 / 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
  }

  @media (width >= 64rem) {
    .hero-glow {
      background: radial-gradient(900px 520px at 78% 38%, rgb(110 121 242 / 0.1), transparent 70%);
    }
  }
</style>
