---
const columns = [
  { label: 'Universe', cards: 4, tone: 'plain' },
  { label: 'Shortlist', cards: 2, tone: 'amber' },
  { label: 'Declined', cards: 1, tone: 'hollow' },
] as const;
---

<div class="grid h-full w-full grid-cols-3 gap-2 px-[22px] py-7" aria-hidden="true">
  {columns.map((column) => (
    <div class="flex flex-col gap-1.5">
      <span
        class:list={[
          'font-mono text-[9.5px] font-medium tracking-[0.06em] uppercase',
          column.tone === 'amber' ? 'text-amber-deep' : 'text-text-2',
        ]}
      >
        {column.label}
      </span>
      {Array.from({ length: column.cards }, () => (
        <span
          class:list={[
            'h-[22px] rounded-md border',
            column.tone === 'plain' && 'border-line bg-panel',
            column.tone === 'amber' && 'border-amber-deep/40 bg-amber-dim',
            column.tone === 'hollow' && 'border-line',
          ]}
        />
      ))}
    </div>
  ))}
</div>
