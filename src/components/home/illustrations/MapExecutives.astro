---
import Icon from '~/components/site/Icon.astro';

const companies = [['bg-d-accent', 'bg-d-text-3', 'bg-slate-line'], ['bg-d-text-3']];
---

<div class="flex w-full flex-col gap-2 px-[26px]" aria-hidden="true">
  {companies.map((people) => (
    <div class="flex items-center gap-[9px] rounded-[10px] border border-line bg-panel p-2.5">
      <span class="size-6 rounded-md border border-line bg-panel-2" />
      <span class="h-[7px] flex-1 rounded bg-slate-line" />
      <div class="flex">
        {people.map((colour, index) => (
          <span
            class:list={[
              'size-[22px] rounded-full border-2 border-white',
              colour,
              index > 0 && '-ml-[7px]',
            ]}
          />
        ))}
      </div>
    </div>
  ))}
  <div class="flex items-center gap-2 rounded-[10px] border border-dashed border-slate-line p-2.5 text-[11.5px] font-medium text-text-2">
    <Icon name="plus" size={14} strokeWidth={2} />
    Add executive
  </div>
</div>
