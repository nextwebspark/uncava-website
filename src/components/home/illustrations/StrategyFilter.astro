---
const filters = [
  { label: 'Energy', active: false },
  { label: '1,000–10,000', active: false },
  { label: 'DACH', active: true },
];
const rows = [{ ticked: true }, { ticked: true }, { ticked: false }];
---

<div class="flex w-full flex-col gap-2.5 px-[26px]" aria-hidden="true">
  <div class="flex flex-wrap gap-1.5">
    {filters.map((filter) => (
      <span
        class:list={[
          'rounded-full border px-[9px] py-1 text-[11px] font-medium',
          filter.active
            ? 'border-accent-deep/35 bg-accent-dim text-accent-deep'
            : 'border-line bg-panel text-text-2',
        ]}
      >
        {filter.label}
      </span>
    ))}
  </div>
  <div class="overflow-hidden rounded-[10px] border border-line bg-panel">
    {rows.map((row) => (
      <div class="flex items-center gap-2 border-b border-line-soft px-2.5 py-2 last:border-b-0">
        <span
          class:list={[
            'size-3 rounded-[3px]',
            row.ticked ? 'bg-text' : 'border-[1.5px] border-slate-line',
          ]}
        />
        <span
          class:list={['h-1.5 flex-1 rounded-[3px]', row.ticked ? 'bg-slate-line' : 'bg-line']}
        />
        <span class="h-1.5 w-[30px] rounded-[3px] bg-line" />
      </div>
    ))}
  </div>
</div>
