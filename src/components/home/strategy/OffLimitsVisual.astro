---
import Icon from '~/components/site/Icon.astro';

const barred = [
  { company: 'Al Naseem Utilities', reason: 'Client subsidiary' },
  { company: 'Dunes Power', reason: 'Agreement' },
];
---

<div class="flex items-center gap-[7px] text-[12.5px] font-semibold">
  <Icon name="lock" size={14} />
  Off-limits for this mandate
</div>
{barred.map((entry) => (
  <div class="flex items-center justify-between rounded-[7px] border border-line bg-panel px-2.5 py-[7px] text-[12.5px] font-medium">
    {entry.company}
    <span class="text-[11px] font-normal text-text-2">{entry.reason}</span>
  </div>
))}
<p class="text-[11.5px] text-text-2">Dropped from every search, count and bulk add.</p>
