---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const executives = [
  { initials: 'LB', name: 'Lena Brandt', title: 'CFO' },
  { initials: 'JK', name: 'Jonas Keller', title: 'VP Finance' },
];
---

<div
  class:list={[
    'rounded-[14px] border border-ink-line bg-ink-2/92 p-4 shadow-float backdrop-blur-sm',
    className,
  ]}
  aria-hidden="true"
>
  <div class="mb-3 flex items-center justify-between">
    <span class="eyebrow text-[10.5px] text-d-text-3">Germany</span>
    <span class="font-mono text-[11px] font-medium text-d-text-3">3 companies · 7 executives</span>
  </div>
  <div class="flex flex-col gap-2.5">
    <div class="flex items-center gap-2.5">
      <span class="grid size-7 place-items-center rounded-[7px] border border-ink-line bg-graphite-1 text-[11px] font-semibold text-d-text-2">
        NW
      </span>
      <div class="min-w-0 flex-1">
        <div class="text-[13px] font-medium text-d-text">Nordwind Energie</div>
        <div class="text-[11.5px] text-d-text-3">Hamburg · 4,200 employees</div>
      </div>
      <span class="rounded-[5px] bg-amber px-1.5 py-[3px] font-mono text-[10.5px] font-medium text-on-amber">
        Shortlisted
      </span>
    </div>
    <div class="ml-[13px] flex flex-col gap-2 border-l border-ink-line pl-[23px]">
      {executives.map((person) => (
        <div class="flex items-center gap-[9px]">
          <span class="grid size-[22px] place-items-center rounded-full bg-graphite-2 text-[9.5px] font-semibold text-d-text-2">
            {person.initials}
          </span>
          <span class="text-[12.5px] font-medium text-d-text">{person.name}</span>
          <span class="text-xs text-d-text-3">{person.title}</span>
        </div>
      ))}
    </div>
    <div class="flex items-center gap-2.5">
      <span class="grid size-7 place-items-center rounded-[7px] border border-ink-line bg-graphite-1 text-[11px] font-semibold text-d-text-2">
        RH
      </span>
      <div class="min-w-0 flex-1">
        <div class="text-[13px] font-medium text-d-text">Rheinwerk Power</div>
        <div class="text-[11.5px] text-d-text-3">Essen · 11,800 employees</div>
      </div>
      <span class="rounded-[5px] border border-ink-line px-1.5 py-[3px] font-mono text-[10.5px] font-medium text-d-text-2">
        In universe
      </span>
    </div>
  </div>
</div>
