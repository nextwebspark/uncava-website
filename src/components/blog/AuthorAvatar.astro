---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  avatar?: ImageMetadata | undefined;
  size?: 36 | 40;
}

const { name, avatar, size = 36 } = Astro.props;
const initials = name
  .replace(/[[\]]/g, '')
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

{avatar ? (
  <Image
    src={avatar}
    alt=""
    width={size}
    height={size}
    class="shrink-0 rounded-full border border-line object-cover"
  />
) : (
  <span
    class:list={[
      'grid shrink-0 place-items-center rounded-full border border-line bg-panel-2 text-xs font-semibold text-text-2',
      size === 40 ? 'size-10' : 'size-9',
    ]}
    aria-hidden="true"
  >
    {initials}
  </span>
)}
