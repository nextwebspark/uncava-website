---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { blogTagLabel } from '~/lib/blog-tags';
import AuthorAvatar from './AuthorAvatar.astro';
import PostMeta from './PostMeta.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  author: CollectionEntry<'authors'>;
  minutes: number;
}

const { post, author, minutes } = Astro.props;
const [primaryTag] = post.data.tags;
---

<article class="group relative grid overflow-hidden rounded-[20px] border border-line bg-panel transition-shadow hover:shadow-window lg:grid-cols-[minmax(0,760px)_1fr]">
  <div class="h-[220px] overflow-hidden bg-ink sm:h-[320px] lg:h-[420px]">
    <Image
      src={post.data.cover}
      alt={post.data.coverAlt}
      widths={[480, 760, 1140, 1520]}
      sizes="(min-width: 1024px) 760px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="flex flex-col justify-between gap-6 p-6 sm:p-8 lg:p-12">
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-2.5">
        {primaryTag && (
          <span class="rounded-md bg-amber-dim px-[9px] py-1 text-xs font-medium text-amber-deep">
            {blogTagLabel(primaryTag)}
          </span>
        )}
        <span class="font-mono text-[13px] text-text-3">Featured</span>
      </div>
      <h2 class="text-[28px] leading-[1.12] tracking-[-0.035em] sm:text-4xl">
        <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 group-hover:text-text">
          {post.data.title}
        </a>
      </h2>
      <p class="text-[16.5px] leading-[1.6] text-text-2">{post.data.description}</p>
    </div>
    <div class="flex items-center gap-3">
      <AuthorAvatar name={author.data.name} avatar={author.data.avatar} />
      <div class="flex flex-col">
        <span class="text-sm font-medium">{author.data.name}</span>
        <PostMeta date={post.data.pubDate} minutes={minutes} />
      </div>
    </div>
  </div>
</article>
