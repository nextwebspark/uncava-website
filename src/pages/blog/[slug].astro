---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import AuthorAvatar from '~/components/blog/AuthorAvatar.astro';
import CopyLinkButton from '~/components/blog/CopyLinkButton.astro';
import PostMeta from '~/components/blog/PostMeta.astro';
import ButtonLink from '~/components/site/ButtonLink.astro';
import Icon from '~/components/site/Icon.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { relatedPosts } from '~/lib/blog';
import { blogTagLabel } from '~/lib/blog-tags';
import { getAuthor, getPublishedPosts, minutesToRead } from '~/lib/content';
import { blogPosting, breadcrumbList } from '~/lib/seo/jsonld';
import { absoluteUrl, ogImagePathFor } from '~/lib/seo/url';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const author = await getAuthor(post);
const minutes = minutesToRead(post);
const path = `/blog/${post.id}`;
const [primaryTag] = post.data.tags;
const tagLabels = post.data.tags.map(blogTagLabel);
const toc = headings.filter((heading) => heading.depth === 2);
const shareUrl = absoluteUrl(path);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  canonical={post.data.canonical ?? path}
  draft={post.data.draft}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: tagLabels,
  }}
  jsonLd={[
    blogPosting({
      title: post.data.title,
      description: post.data.description,
      path,
      imagePath: ogImagePathFor(path),
      publishedAt: post.data.pubDate,
      updatedAt: post.data.updatedDate,
      authorName: author.data.name,
      authorUrl: author.data.url,
      tags: tagLabels,
    }),
    breadcrumbList([
      { name: 'Blog', path: '/blog' },
      { name: post.data.title, path },
    ]),
  ]}
>
  <article>
    <header class="container-page flex flex-col items-center pt-10 pb-8 md:pt-[72px] md:pb-12">
      <div class="flex w-full max-w-[880px] flex-col gap-4 md:gap-[22px]">
        <nav aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-text-3">
            <li>
              <a href="/blog" class="hover:text-text">
                Blog
              </a>
            </li>
            {primaryTag && (
              <li class="flex items-center gap-2">
                <span aria-hidden="true">/</span>
                <a href={`/blog/tag/${primaryTag}`} class="text-accent-deep hover:underline">
                  {blogTagLabel(primaryTag)}
                </a>
              </li>
            )}
          </ol>
        </nav>
        <h1 class="text-[36px] leading-[1.06] tracking-display md:text-5xl lg:text-[60px] lg:leading-[1.04]">
          {post.data.title}
        </h1>
        <p class="text-lg leading-[1.55] text-pretty text-text-2 md:text-[21px]">
          {post.data.description}
        </p>
        <div class="mt-1.5 flex items-center justify-between gap-4 border-t border-line pt-[22px]">
          <div class="flex items-center gap-3">
            <AuthorAvatar name={author.data.name} avatar={author.data.avatar} size={40} />
            <div class="flex flex-col">
              <span class="text-[15px] font-medium">{author.data.name}</span>
              <PostMeta date={post.data.pubDate} minutes={minutes} />
            </div>
          </div>
          <div class="flex gap-2">
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="grid size-[38px] place-items-center rounded-[9px] border border-line text-text-2 transition-colors hover:border-slate-line hover:text-text"
            >
              <span class="sr-only">Share on LinkedIn</span>
              <Icon name="linkedin" />
            </a>
            <CopyLinkButton url={shareUrl} />
          </div>
        </div>
      </div>
    </header>

    <div class="container-page pb-10 md:pb-16">
      <div class="h-[220px] overflow-hidden rounded-2xl bg-ink sm:h-[320px] md:rounded-[20px] lg:h-[460px]">
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1440px) 1280px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <div class="container-page grid gap-12 pb-16 md:pb-24 xl:grid-cols-[240px_minmax(0,720px)_240px] xl:justify-center xl:gap-[60px]">
      {toc.length > 0 && (
        <nav aria-labelledby="toc-title" class="hidden xl:block">
          <div class="sticky top-8 flex flex-col gap-3 pt-2">
            <p id="toc-title" class="eyebrow text-[11px] text-text-3">
              On this page
            </p>
            <ol class="flex flex-col gap-3">
              {toc.map((heading, index) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      'block text-sm leading-[1.4] transition-colors hover:text-text',
                      index === 0
                        ? 'border-l-2 border-accent pl-3 text-text'
                        : 'pl-3.5 text-text-3',
                    ]}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )}

      <div class="mx-auto flex w-full max-w-[720px] flex-col gap-8 xl:col-start-2">
        <div class="article-prose">
          <Content />
        </div>

        {post.data.inUncava && (
          <aside class="flex flex-col items-start justify-between gap-5 rounded-[14px] bg-ink px-6 py-6 text-d-text sm:flex-row sm:items-center sm:gap-6 sm:px-[26px]">
            <div class="flex flex-col gap-1.5">
              <p class="eyebrow text-[11px] text-d-accent">In Uncava</p>
              <p class="text-base leading-[1.6] text-d-text-2">{post.data.inUncava.text}</p>
            </div>
            <a
              href={post.data.inUncava.href}
              class="flex-none rounded-[9px] border border-ink-line px-4 py-2.5 text-sm font-medium text-d-text hover:border-graphite-3"
            >
              {post.data.inUncava.label}
            </a>
          </aside>
        )}
      </div>

      <aside aria-label="Book a demo" class="xl:col-start-3">
        <div class="sticky top-8 flex flex-col gap-3 rounded-[14px] border border-line bg-panel p-[22px] xl:mt-2">
          <p class="text-base leading-[1.3] font-semibold">Map your next mandate with us.</p>
          <p class="text-sm leading-[1.55] text-text-2">Thirty minutes, one live search.</p>
          <ButtonLink href="/contact" size="sm">
            Book a demo
          </ButtonLink>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section aria-labelledby="related-title" class="border-t border-line">
      <div class="container-page flex flex-col gap-8 pt-14 pb-16 md:pt-[72px] md:pb-24">
        <h2 id="related-title" class="text-[30px] tracking-[-0.03em]">
          Keep reading
        </h2>
        <ul class="grid gap-7 md:grid-cols-3">
          {related.map((entry) => (
            <li>
              <a
                href={`/blog/${entry.id}`}
                class="flex h-full flex-col gap-2.5 rounded-[14px] border border-line bg-panel p-6 text-text transition-colors hover:border-slate-line"
              >
                <span class="font-mono text-[13px] text-text-3">
                  {entry.data.tags[0] ? blogTagLabel(entry.data.tags[0]) : 'Blog'}
                </span>
                <span class="text-[19px] leading-[1.3] font-semibold tracking-title">
                  {entry.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
