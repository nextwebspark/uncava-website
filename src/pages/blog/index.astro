---
import BlogListing from '~/components/blog/BlogListing.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { BLOG_TAG_SLUGS } from '~/lib/blog-tags';
import { getPublishedPosts } from '~/lib/content';
import { staticPages } from '~/lib/pages';
import { breadcrumbList } from '~/lib/seo/jsonld';

const page = staticPages.blog;
const posts = await getPublishedPosts();
const availableTags = BLOG_TAG_SLUGS.filter((slug) =>
  posts.some((post) => post.data.tags.includes(slug)),
);
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  jsonLd={[breadcrumbList([{ name: 'Blog', path: page.path }])]}
>
  <BlogListing
    eyebrow="Blog"
    heading="Field notes on executive search."
    intro="How research teams map markets, make decisions about companies, and keep clients close to the search — and what we’re building to help."
    posts={posts}
    currentTag="all"
    availableTags={availableTags}
    featureFirst={true}
  />
</BaseLayout>
