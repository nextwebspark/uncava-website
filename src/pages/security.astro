---
import ButtonLink from '~/components/site/ButtonLink.astro';
import Icon from '~/components/site/Icon.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { staticPages } from '~/lib/pages';
import { securityPoints } from '~/lib/security-points';
import { breadcrumbList, faqPage, type FrequentlyAskedQuestion } from '~/lib/seo/jsonld';

const page = staticPages.security;

const questions: FrequentlyAskedQuestion[] = [
  {
    question: 'Can another firm see our data?',
    answer:
      'No. Every read is scoped to your firm’s workspace on the server, and nobody joins a workspace without an invitation.',
  },
  {
    question: 'What can a client representative see?',
    answer:
      'Only the mandates they are attached to, and only to read. Their access is checked on every request rather than remembered.',
  },
  {
    question: 'Is candidate data sent to AI when we import a spreadsheet?',
    answer:
      'No. When AI helps map a spreadsheet it sees column headers and the shape of their values, never the names, salaries or notes in the cells. A file whose headers Uncava already knows is mapped with no AI step at all.',
  },
  {
    question: 'Is a position description sent to AI?',
    answer:
      'Yes, when you choose Read from document. Client names and contact details are pseudonymised first, compensation is never read, and nothing is written until you accept each proposal.',
  },
  {
    question: 'Does Uncava’s AI file anything on its own?',
    answer:
      'No. The assistant and the AI assessment suggest; a consultant chooses what is filed and at which stage. AI output is marked in purple, with its sources or the sentence it came from.',
  },
  {
    question: 'What does an AI candidate assessment read?',
    answer:
      'The executive’s LinkedIn profile and public web pages such as press coverage, leadership pages, talks, awards and board listings. Every source it used is listed with the assessment.',
  },
  {
    question: 'How is AI kept in bounds?',
    answer:
      'Every AI call runs behind prompt-injection guards and a per-user budget, and client names and contact details are masked before text reaches the model.',
  },
];

const openItems = [
  {
    heading: 'Hosting and data location',
    body: '[Where Uncava is hosted and where customer data is stored.]',
  },
  { heading: 'Encryption', body: '[Encryption in transit and at rest.]' },
  {
    heading: 'Sign-in and sessions',
    body: '[Password, Google and LinkedIn sign-in; session handling.]',
  },
  {
    heading: 'AI providers',
    body: '[Which model provider processes documents and headers, and under what terms.]',
  },
  { heading: 'Sub-processors', body: '[List of sub-processors, or a link to it.]' },
  { heading: 'Certifications and audits', body: '[Certifications held or in progress, if any.]' },
  {
    heading: 'Reporting a vulnerability',
    body: '[Security contact address and disclosure policy.]',
  },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  jsonLd={[breadcrumbList([{ name: 'Security', path: page.path }]), faqPage(questions)]}
>
  <header class="container-page grid gap-4 pt-14 pb-10 md:grid-cols-2 md:items-end md:gap-20 md:pt-[88px] md:pb-14">
    <div class="flex flex-col gap-3.5 md:gap-[18px]">
      <p class="eyebrow text-accent-deep">Security</p>
      <h1 class="text-[40px] leading-[1.02] tracking-display md:text-[52px] xl:text-[64px] xl:leading-none">
        Confidential by design.
      </h1>
    </div>
    <p class="max-w-[520px] text-[17px] leading-[1.6] text-text-2 md:text-lg">
      Executive search runs on discretion. Uncava is built so the wrong person never sees a name.
    </p>
  </header>

  <section aria-labelledby="principles-title" class="bg-ink text-d-text">
    <div class="container-page py-16 md:py-24">
      <h2 id="principles-title" class="sr-only">
        How Uncava keeps a search confidential
      </h2>
      <ul class="grid gap-px overflow-hidden rounded-2xl border border-ink-line bg-ink-line md:grid-cols-2">
        {securityPoints.map((point) => (
          <li class="flex flex-col gap-3 bg-ink p-6 md:p-8">
            <Icon name={point.icon} size={22} strokeWidth={1.7} class="text-d-accent" />
            <h3 class="text-lg">{point.title}</h3>
            <p class="text-[14.5px] leading-[1.6] text-d-text-3">{point.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    aria-labelledby="faq-title"
    class="container-page grid gap-8 py-16 md:py-24 lg:grid-cols-[minmax(0,400px)_1fr] lg:gap-16"
  >
    <div class="flex flex-col gap-3.5">
      <p class="eyebrow text-accent-deep">Questions</p>
      <h2 id="faq-title" class="text-[30px] leading-[1.08] tracking-[-0.035em] md:text-[40px]">
        What clients and candidates ask us.
      </h2>
    </div>
    <div class="flex flex-col border-t border-line">
      {questions.map((item) => (
        <details class="group border-b border-line">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
            {item.question}
            <Icon
              name="chevron-down"
              class="text-text-3 transition-transform group-open:rotate-180"
            />
          </summary>
          <p class="pb-5 text-[15.5px] leading-[1.65] text-text-2">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section aria-labelledby="details-title" class="border-t border-line">
    <div class="container-page grid gap-8 py-16 md:py-24 lg:grid-cols-[minmax(0,400px)_1fr] lg:gap-16">
      <div class="flex flex-col gap-3.5">
        <p class="eyebrow text-accent-deep">In detail</p>
        <h2
          id="details-title"
          class="text-[30px] leading-[1.08] tracking-[-0.035em] md:text-[40px]"
        >
          The specifics.
        </h2>
      </div>
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {openItems.map((item) => (
          <div class="flex flex-col gap-1.5">
            <dt class="text-base font-semibold">{item.heading}</dt>
            <dd class="text-[15px] leading-[1.6] text-text-2">{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section aria-labelledby="security-cta-title" class="container-page pb-16 md:pb-24">
    <div class="flex flex-col items-start justify-between gap-5 rounded-[20px] border border-line bg-panel p-6 sm:p-10 md:flex-row md:items-center">
      <div class="flex flex-col gap-2">
        <h2 id="security-cta-title" class="text-2xl tracking-title">
          Need a security review before a pilot?
        </h2>
        <p class="text-[15px] text-text-2">Book a call and bring your questions.</p>
      </div>
      <ButtonLink href="/contact">Book a demo</ButtonLink>
    </div>
  </section>
</BaseLayout>
