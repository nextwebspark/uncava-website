---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { staticPages } from '~/lib/pages';
import { isPlaceholder } from '~/lib/placeholder';
import { breadcrumbList } from '~/lib/seo/jsonld';
import { site } from '~/lib/site';

const page = staticPages.contact;
const endpoint = import.meta.env.PUBLIC_DEMO_FORM_ENDPOINT;
const emailIsReal = !isPlaceholder(site.contactEmail);

const steps = [
  {
    number: '01',
    title: 'A 30-minute call',
    body: 'A walkthrough on your search, not a slide deck.',
  },
  {
    number: '02',
    title: 'Your mandate, mapped live',
    body: 'Brief, strategy and a first shortlist, built on screen.',
  },
  {
    number: '03',
    title: 'A workspace for your team',
    body: 'If it fits, we set up your workspace and you invite your researchers.',
  },
];

const teamSizes = ['Just me', '2–5 people', '6–20 people', '21–50 people', 'More than 50 people'];

const field =
  'min-h-[46px] w-full rounded-[9px] border border-line bg-panel px-3.5 py-3 text-[15px] text-text placeholder:text-text-3 focus:border-accent disabled:bg-panel-2';
const label = 'text-[13.5px] font-medium text-text';
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  jsonLd={[breadcrumbList([{ name: 'Book a demo', path: page.path }])]}
>
  <section class="container-page grid items-start gap-12 pt-12 pb-16 md:pt-24 md:pb-[120px] lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] lg:gap-16 xl:grid-cols-[minmax(0,1fr)_600px] xl:gap-24">
    <div class="flex flex-col gap-6 md:gap-7 lg:pt-3">
      <p class="eyebrow text-accent-deep">Book a demo</p>
      <h1 class="text-[40px] leading-[1.04] tracking-display md:text-5xl xl:text-[60px] xl:leading-[1.02]">
        See Uncava on one of your own mandates.
      </h1>
      <p class="max-w-[520px] text-[17px] leading-[1.6] text-text-2 md:text-lg">
        Bring a live search. We’ll build its brief, pull a first universe of companies and put it on
        a map — in the call, with you.
      </p>

      <ol class="mt-3 flex flex-col border-t border-line">
        {steps.map((step) => (
          <li class="grid grid-cols-[48px_minmax(0,1fr)] gap-2 border-b border-line py-[22px]">
            <span class="pt-[3px] font-mono text-[13px] font-medium text-accent-deep">
              {step.number}
            </span>
            <div class="flex flex-col gap-1">
              <h2 class="text-[17px]">{step.title}</h2>
              <p class="text-[15px] leading-[1.55] text-text-2">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="text-[15px] text-text-2">
        Prefer email? Write to{' '}
        {emailIsReal ? (
          <a href={`mailto:${site.contactEmail}`} class="link-inline">
            {site.contactEmail}
          </a>
        ) : (
          <span class="text-accent">{site.contactEmail}</span>
        )}
      </p>
    </div>

    <form
      action={endpoint}
      method="post"
      aria-labelledby="demo-form-title"
      class="flex flex-col gap-5 rounded-[20px] border border-line bg-panel p-6 shadow-form sm:p-10"
    >
      <div class="flex flex-col gap-1.5">
        <h2 id="demo-form-title" class="text-2xl tracking-title">
          Tell us about your search
        </h2>
        <p class="text-[14.5px] text-text-3">[Reply time, e.g. within one working day]</p>
      </div>

      <fieldset disabled={!endpoint} class="flex flex-col gap-5">
        <legend class="sr-only">Your details</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-[7px]">
            <label for="first-name" class={label}>
              First name
            </label>
            <input
              id="first-name"
              name="first_name"
              type="text"
              required
              autocomplete="given-name"
              class={field}
            />
          </div>
          <div class="flex flex-col gap-[7px]">
            <label for="last-name" class={label}>
              Last name
            </label>
            <input
              id="last-name"
              name="last_name"
              type="text"
              required
              autocomplete="family-name"
              class={field}
            />
          </div>
        </div>
        <div class="flex flex-col gap-[7px]">
          <label for="work-email" class={label}>
            Work email
          </label>
          <input
            id="work-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@firm.com"
            class={field}
          />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-[7px]">
            <label for="firm" class={label}>
              Firm
            </label>
            <input
              id="firm"
              name="firm"
              type="text"
              required
              autocomplete="organization"
              class={field}
            />
          </div>
          <div class="flex flex-col gap-[7px]">
            <label for="team-size" class={label}>
              Team size
            </label>
            <select
              id="team-size"
              name="team_size"
              required
              class:list={[field, 'appearance-auto']}
            >
              <option value="" selected disabled>
                Select
              </option>
              {teamSizes.map((size) => (
                <option value={size}>{size}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="flex flex-col gap-[7px]">
          <label for="search" class={label}>
            What are you searching for? <span class="font-normal text-text-3">Optional</span>
          </label>
          <textarea
            id="search"
            name="search"
            rows="4"
            placeholder="e.g. a Group CFO for an energy business in Saudi Arabia"
            class:list={[field, 'min-h-[112px] resize-y']}
          ></textarea>
        </div>
        <div class="flex items-start gap-2.5 text-[13.5px] leading-[1.5] text-text-2">
          <input
            id="consent"
            name="consent"
            type="checkbox"
            required
            class="mt-0.5 size-[18px] flex-none rounded-[5px] accent-text"
          />
          <label for="consent">
            We’ll use these details only to arrange your demo. See our{' '}
            <a href="/privacy" class="link-inline">
              privacy policy
            </a>
            .
          </label>
        </div>
      </fieldset>

      {endpoint ? (
        <button
          type="submit"
          class="min-h-[52px] rounded-[10px] bg-accent px-4 text-base font-semibold text-on-accent transition-colors hover:bg-accent-hover"
        >
          Book a demo
        </button>
      ) : (
        <p class="rounded-[10px] border border-dashed border-slate-line px-4 py-3.5 text-center text-[15px] text-text-2">
          Online booking isn’t connected yet. Email{' '}
          <span class="font-medium text-text">{site.contactEmail}</span> to book a demo.
        </p>
      )}
    </form>
  </section>
</BaseLayout>
