---
import ClosingCta from '~/components/home/ClosingCta.astro';
import CompaniesWindow from '~/components/home/CompaniesWindow.astro';
import Features from '~/components/home/Features.astro';
import Hero from '~/components/home/Hero.astro';
import SecurityBand from '~/components/home/SecurityBand.astro';
import Workflow from '~/components/home/Workflow.astro';
import AiResearch from '~/components/home/ai/AiResearch.astro';
import ReportsShowcase from '~/components/home/reports/ReportsShowcase.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { staticPages } from '~/lib/pages';
import { organization, softwareApplication, webSite } from '~/lib/seo/jsonld';

const page = staticPages.home;

const productFeatures = [
  'Position briefs drafted from the client’s position description',
  'AI research assistant for the company universe',
  'AI candidate assessment with cited sources',
  'Spreadsheet import with AI column mapping',
  'Talent mapping by company, executive and location',
  'Mandate reports: market shape, remuneration, diversity and progress',
  'Read-only client seats',
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  ogImagePath="/og-image.png"
  ogImageAlt="Uncava — Map the whole market. Present the right few."
  header="dark-overlay"
  footer="full"
  jsonLd={[
    organization(),
    webSite(),
    softwareApplication({ description: page.description, featureList: productFeatures }),
  ]}
>
  <Hero />
  <Workflow />
  <AiResearch />
  <CompaniesWindow />
  <ReportsShowcase />
  <Features />
  <SecurityBand />
  <ClosingCta />
</BaseLayout>
