---
import AudienceFork from '~/components/home/AudienceFork.astro';
import DemoCta from '~/components/home/DemoCta.astro';
import EarlyEvidence from '~/components/home/EarlyEvidence.astro';
import FaqSection from '~/components/home/FaqSection.astro';
import GroundworkJudgement from '~/components/home/GroundworkJudgement.astro';
import HomeHero from '~/components/home/HomeHero.astro';
import MidCta from '~/components/home/MidCta.astro';
import ShowcaseSection from '~/components/home/ShowcaseSection.astro';
import StagesSection from '~/components/home/StagesSection.astro';
import UncoverSection from '~/components/home/UncoverSection.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { homeFaq } from '~/lib/faq';
import { staticPages } from '~/lib/pages';
import { organization, softwareApplication, webSite } from '~/lib/seo/jsonld';

const page = staticPages.home;

const productFeatures = [
  'Briefs drafted from the job description, every field linked to its source line',
  'Company universe with live-count filters, tiered against the brief by an AI research assistant',
  'Adjacent sectors with transferable talent, each with a reason',
  'Sector × seniority heatmap and talent mapping by country',
  'Outreach sequences from your own inbox, one conversation per person',
  'Interview co-pilot with a question plan, consent-based transcription and live evidence tracking',
  'Competency scoring with evidence and AI-drafted assessment reports',
  'Candidate ranking with what-if weightings',
  'Remuneration benchmarking against disclosed packages',
  'Report chapters shared with hiring managers and clients by link',
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  ogImagePath="/og-image.png"
  ogImageAlt="Uncava — the operating system for executive search."
  theme="dark"
  headerOverlay
  jsonLd={[
    organization(),
    webSite(),
    softwareApplication({ description: page.description, featureList: productFeatures }),
  ]}
>
  <HomeHero />
  <AudienceFork />
  <EarlyEvidence />
  <UncoverSection />
  <GroundworkJudgement />
  <ShowcaseSection />
  <StagesSection />
  <MidCta />
  <FaqSection questions={homeFaq} />
  <DemoCta />
</BaseLayout>

<script>
  import '~/scripts/home';
</script>
