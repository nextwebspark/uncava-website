---
import type { StaticPageMeta } from '~/lib/pages';
import { breadcrumbList } from '~/lib/seo/jsonld';
import BaseLayout from './BaseLayout.astro';

export interface LegalSection {
  id: string;
  heading: string;
  placeholder: string;
}

interface Props {
  page: StaticPageMeta;
  sections: readonly LegalSection[];
}

const { page, sections } = Astro.props;
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  jsonLd={[breadcrumbList([{ name: page.title, path: page.path }])]}
>
  <div class="container-page grid gap-10 pt-14 pb-16 md:pt-[88px] md:pb-24 lg:grid-cols-[220px_minmax(0,720px)] lg:gap-16">
    <header class="flex flex-col gap-4 lg:col-start-2">
      <p class="eyebrow text-amber-deep">Legal</p>
      <h1 class="text-[40px] leading-[1.04] tracking-display md:text-[52px]">{page.title}</h1>
      <p class="font-mono text-[13px] text-text-3">Last updated [Date]</p>
      <p class="rounded-xl border border-amber-deep/30 bg-amber-dim px-[18px] py-4 text-[15px] leading-[1.6] text-amber-ink">
        This page is a placeholder. Every bracketed section must be replaced with text approved by
        counsel before launch.
      </p>
    </header>

    <nav
      aria-labelledby="legal-toc-title"
      class="hidden lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:block"
    >
      <div class="sticky top-8 flex flex-col gap-3">
        <p id="legal-toc-title" class="eyebrow text-[11px] text-text-3">
          On this page
        </p>
        <ol class="flex flex-col gap-2.5">
          {sections.map((section) => (
            <li>
              <a href={`#${section.id}`} class="text-sm leading-[1.4] text-text-3 hover:text-text">
                {section.heading}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="flex flex-col gap-10 lg:col-start-2">
      {sections.map((section, index) => (
        <section
          id={section.id}
          aria-labelledby={`${section.id}-title`}
          class="flex flex-col gap-3"
        >
          <h2 id={`${section.id}-title`} class="text-2xl tracking-title">
            {index + 1}. {section.heading}
          </h2>
          <p class="text-[17px] leading-[1.75] text-prose">{section.placeholder}</p>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
